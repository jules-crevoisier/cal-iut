# Copie ce fichier en `.env` (jamais commité, cf. .gitignore) et remplis les
# valeurs — chargé automatiquement par `cal-iut serve` (cf. cli.py::cmd_serve).
# Une variable déjà positionnée dans ton vrai environnement (terminal,
# Dokploy) garde toujours la priorité sur `.env`.

# Mot de passe unique partagé — OBLIGATOIRE, sans lui TOUTE l'API répond 503
# (cf. src/cal_iut/api/auth.py, blocage volontaire).
CAL_IUT_PASSWORD=

# Optionnel — sans lui, un secret est généré au premier démarrage et écrit
# dans data/.secret_key (stable tant que ce fichier existe). Le fixer évite
# de perdre la validité des liens enseignants déjà envoyés si ce fichier
# disparaît un jour.
# CAL_IUT_SECRET_KEY=

# Envoi automatique du lien perso par mail (POST /mail/teacher-links/send,
# cf. src/cal_iut/api/mailer.py) — les trois suivants sont nécessaires pour
# que le bouton "Envoyer les liens par mail" fonctionne réellement. Sans eux,
# le bouton reste visible mais chaque tentative échoue avec un message
# explicite plutôt qu'un envoi silencieux.
RESEND_API_KEY=
RESEND_FROM=cal-iut@nexkeep.fr
CAL_IUT_PUBLIC_URL=https://cal-iut-mmi.srko.fr

# Synchronisation local <-> production (`cal-iut prod diff|push`, cf.
# src/cal_iut/sync/prod.py). Le mot de passe est celui de CAL_IUT_PASSWORD
# tel qu'il est défini côté Dokploy — pas celui de la machine locale.
CAL_IUT_PROD_URL=https://cal-iut-mmi.srko.fr
CAL_IUT_PROD_PASSWORD=

# ── Celcat, derrière le VPN de l'URCA ────────────────────────────────────
# Celcat n'est pas exposé sur Internet : sans VPN, le nom ne résout même pas.
# `cal-iut celcat-reseau` diagnostique l'accès sans rien envoyer à Celcat.

# URL de Celcat (interne). Sans elle, la saisie ne peut pas vérifier l'accès.
# CELCAT_URL=

# Montage AUTOMATIQUE du VPN — facultatif, et seulement avec l'option
# `--connecter`. Par défaut l'outil se contente de CONSTATER que le VPN est
# absent et vous laisse le monter dans AnyConnect : c'est plus sûr, et c'est
# de toute façon obligatoire si la passerelle demande une validation sur
# téléphone (celle-là ne s'automatise pas, par construction).
# VPN_PASSERELLE=vpn.univ-reims.fr
# VPN_UTILISATEUR=
# VPN_MOT_DE_PASSE=
# VPN_GROUPE=
# Code à usage unique, quand la passerelle en demande un (à renseigner juste
# avant de lancer, il expire vite).
# VPN_CODE=
