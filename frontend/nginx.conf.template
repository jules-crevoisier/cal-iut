# Gabarit — `${BACKEND_URL}` substitué au démarrage du conteneur (variable
# d'environnement Dokploy, défaut `http://backend:8000` défini dans le
# Dockerfile). Sans path/trailing slash — laisser tel quel, ex.
# `http://mon-service-api:8000`.

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # IP RÉELLE DU CLIENT (anti-aspiration, 29/09/2026 — cf.
    # docs/ANTI-ASPIRATION.md). nginx est derrière Traefik (Dokploy) : sans
    # ces lignes, `$remote_addr` est l'IP de Traefik pour TOUT le monde, et
    # le journal d'accès ne dit rien de qui aspire. Traefik ajoute l'IP du
    # client à `X-Forwarded-For` ; on ne croit cet en-tête que s'il vient
    # d'une adresse privée (réseau Docker), et `real_ip_recursive` le lit de
    # droite à gauche en sautant les proxys : un `X-Forwarded-For` inventé
    # par le client reste à gauche et n'est jamais retenu.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from 127.0.0.1;
    set_real_ip_from fc00::/7;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # Vérifié par le HEALTHCHECK du Dockerfile — répond directement depuis
    # nginx, sans dépendre du backend (un conteneur frontend en bonne santé
    # sert ses fichiers statiques même si l'API est momentanément injoignable).
    location = /healthz {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    # Compression : gzip suffit ici (assets déjà compacts, pas de gros
    # médias) — pas besoin de brotli pour ce volume.
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript
               application/xml application/xml+rss text/javascript image/svg+xml;

    # Assets Vite (`/assets/xxx-<hash>.js|css`) : le hash change à chaque
    # contenu différent, donc un cache long + immutable est sûr — un
    # nouveau déploiement produit de nouveaux noms de fichiers, jamais de
    # contenu périmé servi sous une ancienne URL.
    # `X-Robots-Tag` répété dans chaque bloc : un `add_header` dans un
    # `location` annule tous ceux hérités du niveau `server`. Les réponses
    # de l'API le portent déjà (api/anti_aspiration.py::EnTeteNoIndex).
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Robots-Tag "noindex, nofollow" always;
        try_files $uri =404;
    }

    # Tout le reste : fichier statique s'il existe (index.html, favicon…),
    # sinon reverse-proxy vers le backend cal-iut. Pas de repli SPA
    # `try_files $uri /index.html` : le routage interne se fait par
    # fragment d'URL (#vue=...), jamais envoyé au serveur, donc il n'y a
    # aucune route "profonde" à réécrire — juste `/` qui sert index.html
    # normalement. Ce repli "statique d'abord, sinon backend" reste
    # correct même si de nouvelles routes API apparaissent côté serveur
    # sans qu'il faille les lister ici une par une (ancienne approche par
    # liste blanche de préfixes, plus fragile).
    location / {
        add_header Cache-Control "no-cache";
        add_header X-Robots-Tag "noindex, nofollow" always;
        try_files $uri $uri/ @backend;
    }

    # ENVOI D'IMAGES SUR UNE TÂCHE (30/09/2026) — `POST /taches/{id}/images`.
    # Partout ailleurs, `client_max_body_size` garde sa valeur par défaut
    # (1m) : aucune autre route n'a besoin de plus, et ouvrir plus grand
    # partout offrirait des gros corps de requête à n'importe quelle route.
    # 9m = une image de 8 Mo au plus (`api/pieces_jointes.py::
    # TAILLE_MAX_IMAGE`) + les en-têtes du multipart. Le backend revérifie
    # lui-même la taille annoncée et la taille lue.
    #
    # Bloc de proxy COMPLET ici (même contenu que `@backend`), pas un
    # `try_files … @backend` : la taille autorisée est contrôlée dans le bloc
    # qui a reçu la requête, et un saut vers un bloc nommé ne la recontrôle
    # pas de façon fiable.
    location ~ ^/taches/[0-9]+/images/?$ {
        client_max_body_size 9m;
        resolver ${DNS_RESOLVER} valid=10s ipv6=off;
        resolver_timeout 5s;
        set $cible ${BACKEND_URL};
        proxy_pass $cible$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location @backend {
        # RÉSOLUTION DNS À CHAQUE REQUÊTE, pas une seule fois au démarrage.
        #
        # `proxy_pass` avec une valeur 100% littérale résout le nom UNE FOIS,
        # au chargement de la configuration, et grave l'adresse obtenue. Or
        # `backend` est un conteneur : chaque redéploiement lui donne une
        # NOUVELLE adresse. nginx continuait alors d'écrire vers l'ancienne,
        # morte — et tout ce qui passait par le proxy tombait en 502 pendant
        # que le site lui-même (statique) répondait parfaitement, ce qui rend
        # la panne trompeuse : `/` et `/healthz` en 200, toute l'API en 502.
        # Seul un redémarrage du conteneur frontend rétablissait le service,
        # alors que le frontend n'avait rien de cassé.
        #
        # Survenu deux fois en deux jours (06 et 07/09/2026), à chaque fois
        # déclenché par un déploiement du backend — y compris par un merge
        # sans aucun rapport avec lui.
        #
        # Le `resolver` est ce qui manquait pour pouvoir mettre une variable
        # dans `proxy_pass` (sans lui : "no resolver defined to resolve
        # backend", constaté le 27/08/2026). 127.0.0.11 est le DNS interne de
        # Docker ; `valid=10s` borne à dix secondes le temps pendant lequel
        # une adresse périmée peut encore être utilisée.
        resolver ${DNS_RESOLVER} valid=10s ipv6=off;
        resolver_timeout 5s;

        # `$request_uri` est OBLIGATOIRE ici : la transmission automatique de
        # l'URI d'origine ne vaut que pour un `proxy_pass` sans variable.
        # Avec une variable et rien derrière, nginx enverrait la requête sur
        # « / » — toutes les routes de l'API répondraient la même chose.
        set $cible ${BACKEND_URL};
        proxy_pass $cible$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # ÉCRASE l'en-tête (plus `$proxy_add_x_forwarded_for`, qui AJOUTAIT à
        # ce qu'avait envoyé le client) : `$remote_addr` est ici l'IP réelle
        # calculée plus haut (`real_ip_header`), la seule que l'API doit voir.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
